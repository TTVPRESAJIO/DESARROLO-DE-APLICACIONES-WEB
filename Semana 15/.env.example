# =====================================================================
#  ELECTRIC LIFE · ejemplo de variables de entorno  (Semana 15)
#  ---------------------------------------------------------------------
#  Este archivo es solo una PLANTILLA. No contiene datos reales y por
#  eso si se sube al repositorio.
#
#  Para usarlo en el computador local:
#     1. Copialo con el nombre .env
#     2. Pon ahi tus datos reales de PostgreSQL
#
#  El archivo .env esta en .gitignore: nunca llega a GitHub.
#
#  En Render NO hace falta ninguno de estos valores: el panel entrega
#  DATABASE_URL automaticamente y SECRET_KEY la genera el propio Render.
# =====================================================================

# --- Opcion A: una sola cadena de conexion (como en Render) ----------
# DATABASE_URL=postgresql://usuario:clave@servidor:5432/electric_life_web

# --- Opcion B: parametros sueltos (lo normal en local) ---------------
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=escribe_aqui_tu_clave
PGDATABASE=electric_life_web

# --- Clave de firma de sesiones y CSRF -------------------------------
SECRET_KEY=cambia-esto-por-un-valor-largo-y-aleatorio
